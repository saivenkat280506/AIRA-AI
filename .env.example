# ── AIRA environment variables ─────────────────────────────────────────────
# CANONICAL location: copy this file to `frontend/.env.local`
#   cp .env.example frontend/.env.local
# Next.js resolves .env.local relative to its project directory (frontend/),
# so that is the one file the running app reads. `npm run seed` reads the same
# file (repo-root .env.local still works as a legacy fallback, with a warning).

# ── Groq (LLM phrasing of suggestions) ─────────────────────────────────────
# Spec default is llama-3.3-70b-versatile; model availability varies by account
# (this key serves openai/gpt-oss-120b). Check https://console.groq.com/models.
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Hindsight Cloud (the only memory system when configured) ───────────────
# Get a key at https://hindsight.vectorize.io — then create a memory bank
# (any id works; the seed script retains into HINDSIGHT_BANK_ID).
HINDSIGHT_API_KEY=hsk_your_key_here
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=sre-incidents

# ── Backend overrides ──────────────────────────────────────────────────────
# MEMORY_BACKEND=auto|hindsight|fallback   (default auto: live if key present)
# LLM_BACKEND=auto|groq|fallback           (default auto: live if key present)
# DEMO_FALLBACK=1                          # force both local fallbacks
